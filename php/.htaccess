# Carpeta solo para el servidor (librería PHPMailer): nadie puede abrirla desde el navegador.
# enviar.php sigue pudiendo usarla porque la carga desde el disco, no por la web.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
